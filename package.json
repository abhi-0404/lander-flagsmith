{
  "name": "lander-flagsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Lander: lands the Flagsmith experiments you already have, and refuses the ones you should not trust.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lander": "dist/cli.js"
  },
  "scripts": {
    "lander": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx tools/seed/seed.ts",
    "simulate": "pnpm --filter lander-simulator simulate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^15.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  }
}
