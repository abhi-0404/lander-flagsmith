# Anthropic (bring your own key; or `ant auth login` profile)
ANTHROPIC_API_KEY=
LANDER_MODEL=claude-sonnet-5-5
LANDER_EXPLAIN_MODEL=claude-haiku-5-5

# Flagsmith Admin (dedicated org master API key; rotate after the hackathon)
FLAGSMITH_API_KEY=
FLAGSMITH_API_URL=https://api.flagsmith.com
FLAGSMITH_PROJECT_ID=
# environment API keys (not server-side SDK keys) for the environments Lander may act on
LANDER_ENV_STAGING=
LANDER_ENV_PRODUCTION=
# which env names need typed confirmation
LANDER_PROTECTED_ENVS=production

# Flagsmith MCP (hosted by default; stdio fallback uses uvx + FLAGSMITH_API_TOKEN=$FLAGSMITH_API_KEY)
FLAGSMITH_MCP_URL=https://mcp.flagsmith.com
FLAGSMITH_MCP_TRANSPORT=http

# Target repo for code changes
LANDER_REPO_PATH=../lander-demo-shop
LANDER_BASE_BRANCH=main

# Simulator only (server-side SDK keys, one per environment)
FLAGSMITH_SERVER_KEY_STAGING=
FLAGSMITH_SERVER_KEY_PRODUCTION=
